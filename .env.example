# Neo4j (must match NEO4J_AUTH in docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password

# Redis (must match --requirepass in docker-compose.yml)
REDIS_URL=redis://:your_secure_password@localhost:6379/0
CACHE_TTL_SECONDS=600

# MLflow (host port 5001 maps to container port 5000)
MLFLOW_TRACKING_URI=http://localhost:5001

# LLM: any OpenAI-compatible endpoint (OpenAI, or Ollama at http://localhost:11434/v1)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key
LLM_MODEL=gpt-4o-mini

# Embeddings (local sentence-transformers model)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Paths
DATA_DIR=./data
CHROMA_PATH=./data/chroma
REPORTS_DIR=./reports

# Ingestion and retrieval
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K=5
MAX_RETRIES=2
DOCLING_OCR=false
REMOVE_REFERENCES=true
